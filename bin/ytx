#!/bin/sh
set -eu

script=$0
while [ -L "$script" ]; do
  target=$(/usr/bin/readlink "$script")
  case "$target" in
    /*) script=$target ;;
    *) script=$(dirname -- "$script")/$target ;;
  esac
done
plugin_root=$(CDPATH= cd -- "$(dirname -- "$script")/.." && pwd)
exec python3 "$plugin_root/scripts/youtube_cli.py" "$@"
